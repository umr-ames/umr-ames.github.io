# Sécurité : interdire l'exécution de scripts dans le dossier des uploads.
# php_flag est encadré par IfModule : sans cette garde, la directive provoque
# une erreur 500 sur les hébergements en PHP-FPM/CGI (mod_php absent).
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

# Blocage par extension (indépendant de la configuration PHP)
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

# N'autoriser que les images
<FilesMatch "\.(jpg|jpeg|png|webp|gif)$">
  Require all granted
</FilesMatch>

Options -Indexes -ExecCGI
