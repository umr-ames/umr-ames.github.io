# =====================================================
# UMR-AMES — Sécurité du site
# Le dépôt Git est déployé directement dans public_html :
# les fichiers de versionnement et de configuration doivent
# rester inaccessibles depuis le web.
# =====================================================

# ---- Pas de listing de répertoire ----
Options -Indexes

# ---- Forcer HTTPS ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# =====================================================
# MODE MAINTENANCE — DÉBUT
# Le site public répond par une page de maintenance (HTTP 503),
# statut qui indique aux moteurs de recherche une coupure
# temporaire et évite tout déréférencement.
# Restent accessibles : l'espace d'administration (/espace/),
# la page de maintenance et le logo qu'elle affiche.
# Pour remettre le site en ligne, supprimer ce bloc entier
# (de DÉBUT à FIN) puis redéployer.
# =====================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Ne s'applique qu'à la requête initiale : sans cette garde, le service
  # interne de la page d'erreur pourrait être renvoyé en 503 à son tour.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_URI} !^/maintenance\.html$
  RewriteCond %{REQUEST_URI} !^/espace/
  RewriteCond %{REQUEST_URI} !^/logo/
  RewriteCond %{REQUEST_URI} !^/favicon
  RewriteRule ^ - [R=503,L]
</IfModule>
ErrorDocument 503 /maintenance.html

<Files "maintenance.html">
  <IfModule mod_headers.c>
    Header always set Retry-After "3600"
  </IfModule>
</Files>
# MODE MAINTENANCE — FIN

# ---- Fichiers sensibles : jamais servis ----
RedirectMatch 404 /\.git
RedirectMatch 404 /\.github

<FilesMatch "(^\.|\.(yml|yaml|sql|sample\.php|md|log|bak|old|ini|sh)$)">
  Require all denied
</FilesMatch>

<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>

# ---- En-têtes de sécurité ----
<IfModule mod_headers.c>
  # Empêche l'interprétation d'un fichier dans un type différent de celui déclaré
  Header always set X-Content-Type-Options "nosniff"
  # Bloque l'inclusion du site dans une iframe tierce (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Ne fuite pas l'URL complète vers les sites externes
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Coupe l'accès aux capteurs pour les scripts de la page
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  # HSTS : impose HTTPS pendant 1 an (activé une fois le certificat vérifié)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Ne pas exposer la version de PHP
  Header always unset X-Powered-By
</IfModule>

# ---- Masquer la signature du serveur ----
ServerSignature Off
